{
  "name": "mdtxtrt",
  "private": true,
  "type": "module",
  "scripts": {
    "start": "node server.mjs",
    "test": "node --test tests/*.test.mjs",
    "build": "esbuild src/liquid-glass-ui.jsx --bundle --format=esm --platform=browser --target=es2022 --minify --legal-comments=eof --outfile=ui.js"
  },
  "engines": {
    "node": "24.21.0"
  },
  "dependencies": {
    "@samasante/liquid-glass": "0.1.1",
    "busboy": "^1.6.0",
    "htmlparser2": "^10.0.0",
    "marked": "^18.0.14",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "turndown": "^7.2.2"
  },
  "devDependencies": {
    "esbuild": "0.28.2",
    "jsdom": "^27.0.0"
  },
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": "24.21.0",
      "onFail": "error"
