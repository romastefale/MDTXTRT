{
  "name": "mdtxtrt",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "npm run build:editor && npm run build:ui && npm run build:dist",
    "build:editor": "esbuild src/editor-core.mjs --bundle --format=iife --global-name=MDTXTRTEditorCore --platform=browser --target=es2022 --minify --legal-comments=eof --outfile=editor-core.js",
    "build:ui": "esbuild src/liquid-glass-ui.jsx --bundle --format=esm --platform=browser --target=es2022 --define:process.env.NODE_ENV='\"production\"' --minify-syntax --minify-whitespace --legal-comments=eof --outfile=ui.js",
    "build:dist": "node scripts/build-dist.mjs",
    "deploy": "npm run build && tgcloud push",
    "status": "tgcloud status",
    "migrate": "tgcloud migrate",
    "test": "node --import ./tests/tgcloud-sim/register.mjs tests/tgcloud-sim/endpoints.test.mjs && node --import ./tests/tgcloud-sim/register.mjs tests/tgcloud-sim/handler.test.mjs"
  },
  "engines": {
    "node": "24.21.0"
  },
  "dependencies": {
    "turndown": "^7.2.2"
  },
  "devDependencies": {
    "@samasante/liquid-glass": "github:romastefale/liquid-glass#9df1c6b91f569bfc8e4904e9686af640acc1f6be",
    "@tgcloud/cli": "^0.2.0",
    "esbuild": "0.28.2",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  }
}
