{
  "$schema": "https://schema.railpack.com",
  "provider": "node",
  "steps": {
    "install": {
      "deployOutputs": [],
      "commands": [
        {
          "path": "/app/node_modules/.bin"
        },
        {
          "src": "package-lock.json",
          "dest": "package-lock.json"
        },
        {
          "src": "package.json",
          "dest": "package.json"
        },
        "npm --version | grep -Fx 11.19.0",
        "npm ci"
      ]
    },
    "build": {
      "commands": [
        {
          "cmd": "echo \"bundles já compilados no repositório (ui.js, editor-core.js); build pulado de propósito\"",
          "customName": "Skip build: bundles are committed"
        }
      ]
    }
  }
}
