{
  "$schema": "https://schema.railpack.com",
  "provider": "node",
  "steps": {
    "install": {
      "deployOutputs": [],
      "commands": [
        {
          "path": "/app/node_modules/.bin"
        },
        {
          "src": "package-lock.json",
          "dest": "package-lock.json"
        },
        {
          "src": "package.json",
          "dest": "package.json"
        },
        "test \"$(npm --version)\" = \"11.19.0\"",
        "npm ci"
      ]
    }
  }
}
